# ══════════════════════════════════════════════════════════════════════════════
# Loja Veloz — Variáveis de Ambiente (desenvolvimento local)
# Copie este arquivo: cp .env.example .env
# NUNCA commite o .env com credenciais reais!
# ══════════════════════════════════════════════════════════════════════════════

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only
POSTGRES_DB=loja_veloz

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Gateway de Pagamento (Sandbox)
PAGAMENTO_GATEWAY_URL=https://sandbox.gateway-externo.com
PAGAMENTO_GATEWAY_TOKEN=token-sandbox-123

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
